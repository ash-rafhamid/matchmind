# Pick ONE model option. With none set, MatchMind runs in verified template mode.

# Option A - Microsoft Foundry project (recommended; uses `az login` / managed identity)
# FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# FOUNDRY_MODEL=gpt-4.1-mini

# Option B - Azure OpenAI deployment in Foundry (key or Entra ID)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# AZURE_OPENAI_API_KEY=

# Option C - any OpenAI-compatible endpoint (development only)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Let the Host agent reach match data through the MCP server instead of in-process tools
# MATCHMIND_MCP_URL=http://localhost:8765/mcp/

# Requests per client per 10 minutes for model-backed endpoints
AI_REQUESTS_PER_10_MIN=40
